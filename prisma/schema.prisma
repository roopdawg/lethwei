generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  username        String          @unique
  password        String?
  avatar          String?
  role            Role            @default(member)
  banned          Boolean         @default(false)
  // Weekly moderator activity quota (see src/lib/mod-quota.ts). Computed
  // on-the-fly from Thread/Reply rows by the weekly cron job; these two
  // fields just persist the outcome. modDiscountId is the Shopify discount
  // node id behind modDiscountCode, needed to deactivate/reactivate it
  // without re-querying Shopify by code.
  modProbation    Boolean         @default(false)
  modDiscountCode String?
  modDiscountId   String?
  // Scoped voting-only access to the monthly design panel — distinct from
  // Role, since a guest judge (e.g. "Aiden") votes but has none of the
  // rest of /admin (no gym/user/category management, no approve/reject).
  isDesignJudge   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  threads         Thread[]
  replies         Reply[]
  accounts        Account[]
  sessions        Session[]
  designComments  DesignComment[]
  designVotes     DesignVote[]
}

enum Role {
  member
  moderator
  admin
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  icon        String   @default("💬")
  order       Int      @default(0)
  threads     Thread[]
}

model Thread {
  id         String    @id @default(cuid())
  title      String
  body       String
  categoryId String
  userId     String
  pinned     Boolean   @default(false)
  locked     Boolean   @default(false)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  replies    Reply[]
}

model Reply {
  id        String    @id @default(cuid())
  body      String
  threadId  String
  userId    String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  thread    Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model Gym {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  country     String   @default("USA")
  website     String?
  instagram   String?
  description String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum DesignStatus {
  pending
  approved
  rejected
  publishing
  published
  failed
}

/**
 * One AI-generated artwork candidate ("Design A", "Design B", ... within a
 * batch — `label` holds that letter). `batchLabel` is a calendar month
 * ("2026-10") — one batch is one month's voting round, matching the
 * monthly judge panel in src/lib/design-votes.ts. A single design can be
 * produced on several garments at once (e.g. the same art on both men's
 * and women's shorts) — `productTypes` holds the keys selected for
 * publishing, matching the keys in the PRINTIFY_PRODUCT_CONFIG env var
 * (e.g. "mens-shorts"). `status` drives the pipeline: pending → (admin
 * approves — the vote surfaces a favorite but never auto-publishes) →
 * publishing → published, or → failed. `publishResults` is a map of
 * productType → { printifyProductId, shopifyProductId, instagramPostId,
 * error } — a JSON field rather than a child table, since this is
 * admin-only internal tooling and a handful of garment types per design
 * doesn't need a fully normalized join; revisit if that stops being true.
 * `aiTiebreakReason` is set only when this design won its batch via the AI
 * tiebreaker (judge votes tied) rather than a clean majority.
 */
model Design {
  id               String          @id @default(cuid())
  batchLabel       String
  label            String
  imageUrl         String
  svgMarkup        String?
  prompt           String
  productTypes     String[]
  status           DesignStatus    @default(pending)
  publishResults   Json?
  publishError     String?
  aiTiebreakReason String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  comments         DesignComment[]
  votes            DesignVote[]
}

/**
 * One judge's single pick of their favorite design within a batch (month).
 * The unique constraint enforces "one favorite per judge per month," not
 * independent per-design yes/no votes. Voting is advisory — it surfaces a
 * leader on the admin page, but an admin still has to click Approve to
 * actually publish anything (see src/app/api/admin/designs/[id]/approve).
 */
model DesignVote {
  id         String   @id @default(cuid())
  batchLabel String
  designId   String
  voterId    String
  createdAt  DateTime @default(now())
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  voter      User     @relation(fields: [voterId], references: [id])

  @@unique([batchLabel, voterId])
}

/**
 * One visitor's "10% off first order" email-popup signup. Email is unique so
 * repeating the popup never issues a second code to the same address — the
 * API route checks for an existing row and, if found, skips creating a new
 * Shopify discount or sending another email, returning the same generic
 * success response either way (same privacy convention as forgot-password:
 * never leak whether an email has already signed up).
 */
model DiscountSignup {
  id         String   @id @default(cuid())
  email      String   @unique
  code       String?
  discountId String?
  createdAt  DateTime @default(now())
}

model DesignComment {
  id        String    @id @default(cuid())
  body      String
  designId  String
  userId    String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  design    Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}
